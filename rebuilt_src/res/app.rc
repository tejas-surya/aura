#include <winresrc.h>
#include "resource.h"

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,0,0,0
    PRODUCTVERSION 1,0,0,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MYOWNAPP"
            VALUE "FileDescription",  "MYOWNAPP Overlay Assistant"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MYOWNAPP"
            VALUE "OriginalFilename", "MYOWNAPP.exe"
            VALUE "ProductName",      "MYOWNAPP"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "app.manifest"
